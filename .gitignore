# SOPS — encrypted *.sops.yaml files ARE committed (safe); plaintext is never committed.
secrets.*.yaml
!*.sops.yaml
!secrets.example.yaml
# decrypted scratch
*.dec
# lychee link-check cache (offline mode writes none, but guard the dotfile anyway)
.lycheecache

# ── Umbrella boundary ──────────────────────────────────────────────────────
